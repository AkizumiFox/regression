ORD\"><mn mathvariant=\"bold\">1</mn></mrow><mo>,</mo><msub><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">x</mi></mrow><mn>2</mn></msub><mo stretchy=\"false\">)</mo><mo>+</mo><mtext>SS</mtext><mo stretchy=\"false\">(</mo><msub><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">x</mi></mrow><mn>2</mn></msub><mo>∣</mo><mrow data-mjx-texclass=\"ORD\"><mn mathvariant=\"bold\">1</mn></mrow><mo>,</mo><msub><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">x</mi></mrow><mn>1</mn></msub><mo stretchy=\"false\">)</mo><mo>−</mo><mtext>SSR</mtext></mrow><mtext>SST</mtext></mfrac><mo>=</mo><mfrac><mrow><msub><mi>r</mi><mrow data-mjx-texclass=\"ORD\"><mn>12</mn></mrow></msub><mrow data-mjx-texclass=\"OPEN\"><mo minsize=\"1.2em\" maxsize=\"1.2em\">[</mo></mrow><msub><mi>r</mi><mrow data-mjx-texclass=\"ORD\"><mn>12</mn></mrow></msub><mo stretchy=\"false\">(</mo><msubsup><mi>r</mi><mrow data-mjx-texclass=\"ORD\"><mi>y</mi><mn>1</mn></mrow><mn>2</mn></msubsup><mo>+</mo><msubsup><mi>r</mi><mrow data-mjx-texclass=\"ORD\"><mi>y</mi><mn>2</mn></mrow><mn>2</mn></msubsup><mo stretchy=\"false\">)</mo><mo>−</mo><mn>2</mn><msub><mi>r</mi><mrow data-mjx-texclass=\"ORD\"><mi>y</mi><mn>1</mn></mrow></msub><msub><mi>r</mi><mrow data-mjx-texclass=\"ORD\"><mi>y</mi><mn>2</mn></mrow></msub><mrow data-mjx-texclass=\"CLOSE\"><mo minsize=\"1.2em\" maxsize=\"1.2em\">]</mo></mrow></mrow><mrow><mn>1</mn><mo>−</mo><msubsup><mi>r</mi><mrow data-mjx-texclass=\"ORD\"><mn>12</mn></mrow><mn>2</mn></msubsup></mrow></mfrac><mo>.</mo></math></mjx-assistive-mml></mjx-container></span> Deduce that the partial sums of squares add up to the\nregression sum of squares when <span class=\"math inline\"><mjx-container class=\"MathJax\" jax=\"CHTML\" style=\"font-size: 113.1%; position: relative;\" data-tex=\"r_{12}=0\"><mjx-math class=\" MJX-TEX\" aria-hidden=\"true\"><mjx-msub><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D45F TEX-I\"></mjx-c></mjx-mi><mjx-script style=\"vertical-align: -0.15em;\"><mjx-TeXAtom size=\"s\" texclass=\"ORD\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c31\"></mjx-c><mjx-c class=\"mjx-c32\"></mjx-c></mjx-mn></mjx-TeXAtom></mjx-script></mjx-msub><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3D\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c30\"></mjx-c></mjx-mn></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>r</mi><mrow data-mjx-texclass=\"ORD\"><mn>12</mn></mrow></msub><mo>=</mo><mn>0</mn></math></mjx-assistive-mml></mjx-container></span>, that they add up to less when\n<span class=\"math inline\"><mjx-container class=\"MathJax\" jax=\"CHTML\" style=\"font-size: 113.1%; position: relative;\" data-tex=\"r_{y1}=r_{y2}\\neq0\"><mjx-math class=\" MJX-TEX\" aria-hidden=\"true\"><mjx-msub><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D45F TEX-I\"></mjx-c></mjx-mi><mjx-script style=\"vertical-align: -0.15em;\"><mjx-TeXAtom size=\"s\" texclass=\"ORD\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D466 TEX-I\"></mjx-c></mjx-mi><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c31\"></mjx-c></mjx-mn></mjx-TeXAtom></mjx-script></mjx-msub><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3D\"></mjx-c></mjx-mo><mjx-msub space=\"4\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D45F TEX-I\"></mjx-c></mjx-mi><mjx-script style=\"vertical-align: -0.15em;\"><mjx-TeXAtom size=\"s\" texclass=\"ORD\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D466 TEX-I\"></mjx-c></mjx-mi><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c32\"></mjx-c></mjx-mn></mjx-TeXAtom></mjx-script></mjx-msub><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c2260\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c30\"></mjx-c></mjx-mn></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>r</mi><mrow data-mjx-texclass=\"ORD\"><mi>y</mi><mn>1</mn></mrow></msub><mo>=</mo><msub><mi>r</mi><mrow data-mjx-texclass=\"ORD\"><mi>y</mi><mn>2</mn></mrow></msub><mo>≠</mo><mn>0</mn></math></mjx-assistive-mml></mjx-container></span> and <span class=\"math inline\"><mjx-container class=\"MathJax\" jax=\"CHTML\" style=\"font-size: 113.1%; position: relative;\" data-tex=\"0<r_{12}<1\"><mjx-math class=\" MJX-TEX\" aria-hidden=\"true\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c30\"></mjx-c></mjx-mn><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3C\"></mjx-c></mjx-mo><mjx-msub space=\"4\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D45F TEX-I\"></mjx-c></mjx-mi><mjx-script style=\"vertical-align: -0.15em;\"><mjx-TeXAtom size=\"s\" texclass=\"ORD\"><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c31\"></mjx-c><mjx-c class=\"mjx-c32\"></mjx-c></mjx-mn></mjx-TeXAtom></mjx-script></mjx-msub><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3C\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c31\"></mjx-c></mjx-mn></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>0</mn><mo>&lt;</mo><msub><mi>r</mi><mrow data-mjx-texclass=\"ORD\"><mn>12</mn></mrow></msub><mo>&lt;</mo><mn>1</mn></math></mjx-assistive-mml></mjx-container></span>, and give correlations\nfor which they add up to more.</p>","file":"ch09-sums-of-squares/03-sequential-partial.html"}