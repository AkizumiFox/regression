-c class=\"mjx-cAF\"></mjx-c></mjx-mo></mjx-over><mjx-base><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D445 TEX-I\"></mjx-c></mjx-mi></mjx-base></mjx-mover></mjx-TeXAtom><mjx-script style=\"vertical-align: 0.363em;\"><mjx-mn class=\"mjx-n\" size=\"s\"><mjx-c class=\"mjx-c32\"></mjx-c></mjx-mn></mjx-script></mjx-msup></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mrow data-mjx-texclass=\"ORD\"><mover><mi>R</mi><mo stretchy=\"false\">¯</mo></mover></mrow><mn>2</mn></msup></math></mjx-assistive-mml></mjx-container></span></th>\n</tr>\n</thead>\n<tbody>\n<tr class=\"odd\">\n<td>poverty</td>\n<td>0.3599</td>\n<td>0.3466</td>\n</tr>\n<tr class=\"even\">\n<td>single</td>\n<td>0.5719</td>\n<td>0.5629</td>\n</tr>\n<tr class=\"odd\">\n<td>urban</td>\n<td>0.0221</td>\n<td>0.0017</td>\n</tr>\n<tr class=\"even\">\n<td>poverty, single</td>\n<td>0.6410</td>\n<td>0.6257</td>\n</tr>\n<tr class=\"odd\">\n<td>poverty, urban</td>\n<td>0.4626</td>\n<td>0.4398</td>\n</tr>\n<tr class=\"even\">\n<td>single, urban</td>\n<td>0.5844</td>\n<td>0.5668</td>\n</tr>\n<tr class=\"odd\">\n<td>all three</td>\n<td>0.6419</td>\n<td>0.6186</td>\n</tr>\n</tbody>\n</table>\n<p><span class=\"math inline\"><mjx-container class=\"MathJax\" jax=\"CHTML\" style=\"font-size: 113.1%; position: relative;\" data-tex=\"R^2\"><mjx-math class=\" MJX-TEX\" aria-hidden=\"true\"><mjx-msup><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D445 TEX-I\"></mjx-c></mjx-mi><mjx-script style=\"vertical-align: 0.363em;\"><mjx-mn class=\"mjx-n\" size=\"s\"><mjx-c class=\"mjx-c32\"></mjx-c></mjx-mn></mjx-script></mjx-msup></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>R</mi><mn>2</mn></msup></math></mjx-assistive-mml></mjx-container></span> is largest for the full\nmodel, as it must be. <span class=\"math inline\"><mjx-container class=\"MathJax\" jax=\"CHTML\" style=\"font-