5B TEX-I\"></mjx-c></mjx-mi><mjx-msubsup><mjx-TeXAtom texclass=\"ORD\"><mjx-mover><mjx-over style=\"padding-bottom: 0.105em; padding-left: 0.306em; margin-bottom: -0.531em;\"><mjx-mo class=\"mjx-n\" style=\"width: 0; margin-left: -0.25em;\"><mjx-c class=\"mjx-c5E\"></mjx-c></mjx-mo></mjx-over><mjx-base><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D70F TEX-I\"></mjx-c></mjx-mi></mjx-base></mjx-mover></mjx-TeXAtom><mjx-script style=\"vertical-align: -0.284em; margin-left: -0.08em;\"><mjx-mn class=\"mjx-n\" size=\"s\" style=\"margin-left: 0.19em;\"><mjx-c class=\"mjx-c34\"></mjx-c></mjx-mn><mjx-spacer style=\"margin-top: 0.18em;\"></mjx-spacer><mjx-mi class=\"mjx-i\" size=\"s\"><mjx-c class=\"mjx-c1D457 TEX-I\"></mjx-c></mjx-mi></mjx-script></mjx-msubsup><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c29\"></mjx-c></mjx-mo></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msubsup><mi>ω</mi><mi>j</mi><mn>2</mn></msubsup><mo>=</mo><msubsup><mrow data-mjx-texclass=\"ORD\"><mover><mi mathvariant=\"bold\">θ</mi><mo stretchy=\"false\">^</mo></mover></mrow><mi>j</mi><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"normal\">⊤</mi></mrow></msubsup><mrow data-mjx-texclass=\"ORD\"><mover><mi mathvariant=\"bold\">Σ</mi><mo stretchy=\"false\">^</mo></mover></mrow><msub><mrow data-mjx-texclass=\"ORD\"><mover><mi mathvariant=\"bold\">θ</mi><mo stretchy=\"false\">^</mo></mover></mrow><mi>j</mi></msub><mo>=</mo><mo data-mjx-texclass=\"OPEN\" fence=\"false\" stretchy=\"false\">‖</mo><msub><mrow data-mjx-texclass=\"ORD\"><mover><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">z</mi></mrow><mo stretchy=\"false\">^</mo></mover></mrow><mi>j</mi></msub><msup><mo data-mjx-texclass=\"CLOSE\" fence=\"false\" stretchy=\"false\">‖</mo><mn>2</mn></msup><mrow data-mjx-texclass=\"ORD\"><mo>/</mo></mrow><mo stretchy=\"false\">(</mo><mi>n</mi><msubsup><mrow data-mjx-texclass=\"ORD\"><mover><mi>τ</mi><mo stretchy=\"false\">^</mo></mover></mrow><mi>j</mi><mn>4</mn></msubsup><mo stretchy=\"false\">)</mo></math></mjx-assistive-mml></mjx-container></span>,\nand hence <span class=\"math inline\"><mjx-container class=\"MathJax\" jax=\"CHTML\" style=\"font-size: 113.1%; position: relative;\" data-tex=\"\\omega_j^2\\le1/\\hat\\tau_j^2\"><mjx-math class=\" MJX-TEX\" aria-hidden=\"true\"><mjx-msubsup><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D714 TEX-I\"></mjx-c></mjx-mi><mjx-script style=\"vertical-align: -0.284em; margin-left: 0;\"><mjx-mn class=\"mjx-n\" size=\"s\"><mjx-c class=\"mjx-c32\"></mjx-c></mjx-mn><mjx-spacer style=\"margin-top: 0.18em;\"></mjx-spacer><mjx-mi class=\"mjx-i\" size=\"s\"><mjx-c class=\"mjx-c1D457 TEX-I\"></mjx-c></mjx-mi></mjx-script></mjx-msubsup><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c2264\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c31\"></mjx-c></mjx-mn><mjx-TeXAtom texclass=\"ORD\"><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2F\"></mjx-c></mjx-mo></mjx-TeXAtom><mjx-msubsup><mjx-TeXAtom texclass=\"ORD\"><mjx-mover><mjx-over style=\"padding-bottom: 0.105em; padding-left: 0.306em; margin-bottom: -0.531em;\"><mjx-mo class=\"mjx-n\" style=\"width: 0; margin-left: -0.25em;\"><mjx-c class=\"mjx-c5E\"></mjx-c></mjx-mo></mjx-over><mjx-base><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D70F TEX-I\"></mjx-c></mjx-mi></mjx-base></mjx-mover></mjx-TeXAtom><mjx-script style=\"vertical-align: -0.284em; margin-left: -0.08em;\"><mjx-mn class=\"mjx-n\" size=\"s\" style=\"margin-left: 0.19em;\"><mjx-c class=\"mjx-c32\"></mjx-c></mjx-mn><mjx-spacer style=\"margin-top: 0.18em;\"></mjx-spacer><mjx-mi class=\"mjx-i\" size=\"s\"><mjx-c class=\"mjx-c1D457 TEX-I\"></mjx-c></mjx-mi></mjx-script></mjx-msubsup></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msubsup><mi>ω</mi><mi>j</mi><mn>2</mn></msubsup><mo>≤</mo><mn>1</mn><mrow data-mjx-texclass=\"ORD\"><mo>/</mo></mrow><msubsup><mrow data-mjx-texclass=\"ORD\"><mover><mi>τ</mi><mo stretchy=\"false\">^</mo></mover></mrow><mi>j</mi><mn>2</mn></msubsup></math></mjx-assistive-mml></mjx-container></span>. Interpret: a\nsmall <span class=\"math inline\"><mjx-container class=\"MathJax\" jax=\"CHTML\" style=\"font-size: 113.1%; position: relative;\" data-tex=\"\\hat\\tau_j^2\"><mjx-math class=\" MJX-TEX\" aria-hidden=\"true\"><mjx-msubsup><mjx-TeXAtom texclass=\"ORD\"><mjx-mover><mjx-over style=\"padding-bottom: 0.105em; padding-left: 0.306em; margin-bottom: -0.531em;\"><mjx-mo class=\"mjx-n\" style=\"width: 0; margin-left: -0.25em;\"><mjx-c class=\"mjx-c5E\"></mjx-c></mjx-mo></mjx-over><mjx-base><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D70F TEX-I\"></mjx-c></mjx-mi></mjx-base></mjx-mover></mjx-TeXAtom><mjx-script style=\"vertical-align: -0.284em; margin-left: -0.08em;\"><mjx-mn class=\"mjx-n\" size=\"s\" style=\"margin-left: 0.19em;\"><mjx-c class=\"mjx-c32\"></mjx-c></mjx-mn><mjx-spacer style=\"margin-top: 0.18em;\"></mjx-spacer><mjx-mi class=\"mjx-i\" size=\"s\"><mjx-c class=\"mjx-c1D457 TEX-I\"></mjx-c></mjx-mi></mjx-script></mjx-msubsup></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msubsup><mrow data-mjx-texclass=\"ORD\"><mover><mi>τ</mi><mo stretchy=\"false\">^</mo></mover></mrow><mi>j</mi><mn>2</mn></msubsup></math></mjx-assistive-mml></mjx-container></span> (a column that\nthe others explain well) means a large variance for <span class=\"math inline\"><mjx-container class=\"MathJax\" jax=\"CHTML\" style=\"font-size: 113.1%; position: relative;\" data-tex=\"\\hat b_j\"><mjx-math class=\" MJX-TEX\" aria-hidden=\"true\"><mjx-msub><mjx-TeXAtom texclass=\"ORD\"><mjx-mover><mjx-over style=\"padding-bottom: 0.105em; padding-left: 0.214em; margin-bottom: -0.531em;\"><mjx-mo class=\"mjx-n\" style=\"width: 0; margin-left: -0.25em;\"><mjx-c class=\"mjx-c5E\"></mjx-c></mjx-mo></mjx-over><mjx-base><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D44F TEX-I\"></mjx-c></mjx-mi></mjx-base></mjx-mover></mjx-TeXAtom><mjx-script style=\"vertical-align: -0.15em;\"><mjx-mi class=\"mjx-i\" size=\"s\"><mjx-c class=\"mjx-c1D457 TEX-I\"></mjx-c></mjx-mi></mjx-script></mjx-msub></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mrow data-mjx-texclass=\"ORD\"><mover><mi>b</mi><mo stretchy=\"false\">^</mo></mover></mrow><mi>j</mi></msub></math></mjx-assistive-mml></mjx-container></span>. Compare with the variance\ninflation factor (<span class=\"citation\" data-cites=\"def-col-vif\">@def-col-vif</span>).</p>","file":"ch28-high-dimensional/05-debiased-inference.html"}