B\"></mjx-c></mjx-mi></mjx-TeXAtom><mjx-script style=\"vertical-align: -0.288em; margin-left: 0;\"><mjx-TeXAtom size=\"s\" texclass=\"ORD\"><mjx-mi class=\"mjx-n\"><mjx-c class=\"mjx-c22A4\"></mjx-c></mjx-mi></mjx-TeXAtom><mjx-spacer style=\"margin-top: 0.18em;\"></mjx-spacer><mjx-mn class=\"mjx-n\" size=\"s\"><mjx-c class=\"mjx-c32\"></mjx-c></mjx-mn></mjx-script></mjx-msubsup><mjx-msup><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c29\"></mjx-c></mjx-mo><mjx-script style=\"vertical-align: 0.363em;\"><mjx-TeXAtom size=\"s\" texclass=\"ORD\"><mjx-mi class=\"mjx-n\"><mjx-c class=\"mjx-c22A4\"></mjx-c></mjx-mi></mjx-TeXAtom></mjx-script></mjx-msup></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo stretchy=\"false\">(</mo><msubsup><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">Y</mi></mrow><mn>1</mn><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"normal\">⊤</mi></mrow></msubsup><mo>,</mo><msubsup><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">Y</mi></mrow><mn>2</mn><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"normal\">⊤</mi></mrow></msubsup><msup><mo stretchy=\"false\">)</mo><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"normal\">⊤</mi></mrow></msup></math></mjx-assistive-mml></mjx-container></span> is jointly normal with\nmean <span class=\"math inline\"><mjx-container class=\"MathJax\" jax=\"CHTML\" style=\"font-size: 113.1%; position: relative;\" data-tex=\"(\\boldsymbol{\\upmu}_1^{\\top},\\boldsymbol{\\upmu}_2^{\\top})^{\\top}\"><mjx-math class=\" MJX-TEX\" aria-hidden=\"true\"><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c28\"></mjx-c></mjx-mo><mjx-msubsup><mjx-mi class=\"mjx-b\"><mjx-utext style=\"font-size: 88.4%; padding: 0.848em 0 0.226em 0;\" variant=\"bold\">𝛍</mjx-utext></mjx-mi><mjx-script style=\"vertical-align: -0.288em; margin-left: 0;\"><mjx-TeXAtom size=\"s\" texclass=\"ORD\"><mjx-mi class=\"mjx-n\"><mjx-c class=\"mjx-c22A4\"></mjx-c></mjx-mi></mjx-TeXAtom><mjx-spacer style=\"margin-top: 0.18em;\"></mjx-spacer><mjx-mn class=\"mjx-n\" size=\"s\"><mjx-c class=\"mjx-c31\"></mjx-c></mjx-mn></mjx-script></mjx-msubsup><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2C\"></mjx-c></mjx-mo><mjx-msubsup space=\"2\"><mjx-mi class=\"mjx-b\"><mjx-utext style=\"font-size: 88.4%; padding: 0.848em 0 0.226em 0;\" variant=\"bold\">𝛍</mjx-utext></mjx-mi><mjx-script style=\"vertical-align: -0.288em; margin-left: 0;\"><mjx-TeXAtom size=\"s\" texclass=\"ORD\"><mjx-mi class=\"mjx-n\"><mjx-c class=\"mjx-c22A4\"></mjx-c></mjx-mi></mjx-TeXAtom><mjx-spacer style=\"margin-top: 0.18em;\"></mjx-spacer><mjx-mn class=\"mjx-n\" size=\"s\"><mjx-c class=\"mjx-c32\"></mjx-c></mjx-mn></mjx-script></mjx-msubsup><mjx-msup><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c29\"></mjx-c></mjx-mo><mjx-script style=\"vertical-align: 0.363em;\"><mjx-TeXAtom size=\"s\" texclass=\"ORD\"><mjx-mi class=\"mjx-n\"><mjx-c class=\"mjx-c22A4\"></mjx-c></mjx-mi></mjx-TeXAtom></mjx-script></mjx-msup></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo stretchy=\"false\">(</mo><msubsup><mi mathvariant=\"bold\">μ</mi><mn>1</mn><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"normal\">⊤</mi></mrow></msubsup><mo>,</mo><msubsup><mi mathvariant=\"bold\">μ</mi><mn>2</mn><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"normal\">⊤</mi></mrow></msubsup><msup><mo stretchy=\"false\">)</mo><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"normal\">⊤</mi></mrow></msup></math></mjx-assistive-mml></mjx-container></span> and\nblock-diagonal covariance <span class=\"math inline\"><mjx-container class=\"MathJax\" jax=\"CHTML\" style=\"font-size: 113.1%; position: relative;\" data-tex=\"\\operatorname{diag}(\\boldsymbol{\\Sigma}_1,\\boldsymbol{\\Sigma}_2)\"><mjx-math class=\" MJX-TEX\" aria-hidden=\"true\"><mjx-mi class=\"mjx-n\"><mjx-c class=\"mjx-c64\"></mjx-c><mjx-c class=\"mjx-c69\"></mjx-c><mjx-c class=\"mjx-c61\"></mjx-c><mjx-c class=\"mjx-c67\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c28\"></mjx-c></mjx-mo><mjx-msub><mjx-mi class=\"mjx-b\"><mjx-c class=\"mjx-c1D6BA TEX-B\"></mjx-c></mjx-mi><mjx-script style=\"vertical-align: -0.15em;\"><mjx-mn class=\"mjx-n\" size=\"s\"><mjx-c class=\"mjx-c31\"></mjx-c></mjx-mn></mjx-script></mjx-msub><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2C\"></mjx-c></mjx-mo><mjx-msub space=\"2\"><mjx-mi class=\"mjx-b\"><mjx-c class=\"mjx-c1D6BA TEX-B\"></mjx-c></mjx-mi><mjx-script style=\"vertical-align: -0.15em;\"><mjx-mn class=\"mjx-n\" size=\"s\"><mjx-c class=\"mjx-c32\"></mjx-c></mjx-mn></mjx-script></mjx-msub><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c29\"></mjx-c></mjx-mo></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>diag</mi><mo stretchy=\"false\">(</mo><msub><mi mathvariant=\"bold\">Σ</mi><mn>1</mn></msub><mo>,</mo><msub><mi mathvariant=\"bold\">Σ</mi><mn>2</mn></msub><mo stretchy=\"false\">)</mo></math></mjx-assistive-mml></mjx-container></span>. Consequently,\nif also <span class=\"math inline\"><mjx-container class=\"MathJax\" jax=\"CHTML\" style=\"font-size: 113.1%; position: relative;\" data-tex=\"n_1=n_2\"><mjx-math class=\" MJX-TEX\" aria-hidden=\"true\"><mjx-msub><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D45B TEX-I\"></mjx-c></mjx-mi><mjx-script style=\"vertical-align: -0.15em;\"><mjx-mn class=\"mjx-n\" size=\"s\"><mjx-c class=\"mjx-c31\"></mjx-c></mjx-mn></mjx-script></mjx-msub><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3D\"></mjx-c></mjx-mo><mjx-msub space=\"4\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D45B TEX-I\"></mjx-c></mjx-mi><mjx-script style=\"vertical-align: -0.15em;\"><mjx-mn class=\"mjx-n\" size=\"s\"><mjx-c class=\"mjx-c32\"></mjx-c></mjx-mn></mjx-script></mjx-msub></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>n</mi><mn>1</mn></msub><mo>=</mo><msub><mi>n</mi><mn>2</mn></msub></math></mjx-assistive-mml></mjx-container></span>, then <span class=\"math inline\"><mjx-container class=\"MathJax\" jax=\"CHTML\" style=\"font-size: 113.1%; position: relative;\" data-tex=\"\\mathbf{Y}_1+\\mathbf{Y}_2\\sim\\mathrm{N}(\\boldsymbol{\\upmu}_1+\\boldsymbol{\\upmu}_2,\\boldsymbol{\\Sigma}_1+\\boldsymbol{\\Sigma}_2)\"><mjx-math class=\" MJX-TEX\" aria-hidden=\"true\"><mjx-msub><mjx-TeXAtom texclass=\"ORD\"><mjx-mi class=\"mjx-b\"><mjx-c class=\"mjx-c1D418 TEX-B\"></mjx-c></mjx-mi></mjx-TeXAtom><mjx-script style=\"vertical-align: -0.15em;\"><mjx-mn class=\"mjx-n\" size=\"s\"><mjx-c class=\"mjx-c31\"></mjx-c></mjx-mn></mjx-script></mjx-msub><mjx-mo class=\"mjx-n\" space=\"3\"><mjx-c class=\"mjx-c2B\"></mjx-c></mjx-mo><mjx-msub space=\"3\"><mjx-TeXAtom texclass=\"ORD\"><mjx-mi class=\"mjx-b\"><mjx-c class=\"mjx-c1D418 TEX-B\"></mjx-c></mjx-mi></mjx-TeXAtom><mjx-script style=\"vertical-align: -0.15em;\"><mjx-mn class=\"mjx-n\" size=\"s\"><mjx-c class=\"mjx-c32\"></mjx-c></mjx-mn></mjx-script></mjx-msub><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c223C\"></mjx-c></mjx-mo><mjx-TeXAtom space=\"4\" texclass=\"ORD\"><mjx-mi class=\"mjx-n\"><mjx-c class=\"mjx-c4E\"></mjx-c></mjx-mi></mjx-TeXAtom><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c28\"></mjx-c></mjx-mo><mjx-msub><mjx-mi class=\"mjx-b\"><mjx-utext style=\"font-size: 88.4%; padding: 0.848em 0 0.226em 0;\" variant=\"bold\">𝛍</mjx-utext></mjx-mi><mjx-script style=\"vertical-align: -0.15em;\"><mjx-mn class=\"mjx-n\" size=\"s\"><mjx-c class=\"mjx-c31\"></mjx-c></mjx-mn></mjx-script></mjx-msub><mjx-mo class=\"mjx-n\" space=\"3\"><mjx-c class=\"mjx-c2B\"></mjx-c></mjx-mo><mjx-msub space=\"3\"><mjx-mi class=\"mjx-b\"><mjx-utext style=\"font-size: 88.4%; padding: 0.848em 0 0.226em 0;\" variant=\"bold\">𝛍</mjx-utext></mjx-mi><mjx-script style=\"vertical-align: -0.15em;\"><mjx-mn class=\"mjx-n\" size=\"s\"><mjx-c class=\"mjx-c32\"></mjx-c></mjx-mn></mjx-scri