ubsup><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D70E TEX-I\"></mjx-c></mjx-mi><mjx-script style=\"vertical-align: -0.284em; margin-left: 0;\"><mjx-mn class=\"mjx-n\" size=\"s\"><mjx-c class=\"mjx-c32\"></mjx-c></mjx-mn><mjx-spacer style=\"margin-top: 0.18em;\"></mjx-spacer><mjx-mi class=\"mjx-i\" size=\"s\"><mjx-c class=\"mjx-c1D456 TEX-I\"></mjx-c></mjx-mi></mjx-script></mjx-msubsup></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>Var</mi><mo stretchy=\"false\">(</mo><msup><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">c</mi></mrow><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"normal\">⊤</mi></mrow></msup><mrow data-mjx-texclass=\"ORD\"><mover><mi mathvariant=\"bold\">β</mi><mo stretchy=\"false\">^</mo></mover></mrow><mo stretchy=\"false\">)</mo><mo>=</mo><munder><mo data-mjx-texclass=\"OP\">∑</mo><mi>i</mi></munder><msubsup><mi>a</mi><mi>i</mi><mn>2</mn></msubsup><msubsup><mi>σ</mi><mi>i</mi><mn>2</mn></msubsup></math></mjx-assistive-mml></mjx-container></span>.\nConstruct a two-group example in which the ratio of the two is as small\nas you like.</p>","file":"ch23-resampling-inference/01-cases-and-residuals.html"}