-mjx-texclass=\"ORD\"><mi>x</mi><mi>y</mi></mrow><mn>2</mn></msubsup><msub><mi>E</mi><mrow data-mjx-texclass=\"ORD\"><mi>x</mi><mi>x</mi></mrow></msub></mfrac><mrow data-mjx-texclass=\"CLOSE\"><mo minsize=\"1.623em\" maxsize=\"1.623em\">)</mo></mrow><mo>,</mo></math></mjx-assistive-mml></mjx-container></span> and deduce that it exceeds <span class=\"math inline\"><mjx-container class=\"MathJax\" jax=\"CHTML\" style=\"font-size: 113.1%; position: relative;\" data-tex=\"B_{yy}\"><mjx-math class=\" MJX-TEX\" aria-hidden=\"true\"><mjx-msub><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D435 TEX-I\"></mjx-c></mjx-mi><mjx-script style=\"vertical-align: -0.15em;\"><mjx-TeXAtom size=\"s\" texclass=\"ORD\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D466 TEX-I\"></mjx-c></mjx-mi><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D466 TEX-I\"></mjx-c></mjx-mi></mjx-TeXAtom></mjx-script></mjx-msub></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>B</mi><mrow data-mjx-texclass=\"ORD\"><mi>y</mi><mi>y</mi></mrow></msub></math></mjx-assistive-mml></mjx-container></span> iff <span class=\"math inline\"><mjx-container class=\"MathJax\" jax=\"CHTML\" style=\"font-size: 113.1%; position: relative;\" data-tex=\"E_{xy}^2/E_{xx}>T_{xy}^2/T_{xx}\"><mjx-math class=\" MJX-TEX\" aria-hidden=\"true\"><mjx-msubsup><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D438 TEX-I\"></mjx-c></mjx-mi><mjx-script style=\"vertical-align: -0.247em; margin-left: -0.026em;\"><mjx-mn class=\"mjx-n\" size=\"s\" style=\"margin-left: 0.109em;\"><mjx-c class=\"mjx-c32\"></mjx-c></mjx-mn><mjx-spacer style=\"margin-top: 0.297em;\"></mjx-spacer><mjx-TeXAtom size=\"s\" texclass=\"ORD\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D465 TEX-I\"></mjx-c></mjx-mi><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D466 TEX-I\"></mjx-c></mjx-mi></mjx-TeXAtom></mjx-script></mjx-msubsup><mjx-TeXAtom texclass=\"ORD\"><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2