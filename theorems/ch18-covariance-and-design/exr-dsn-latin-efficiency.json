\" space=\"3\"><mjx-c class=\"mjx-c28\"></mjx-c></mjx-mo><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D44E TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\" space=\"3\"><mjx-c class=\"mjx-c2212\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\" space=\"3\"><mjx-c class=\"mjx-c31\"></mjx-c></mjx-mn><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c29\"></mjx-c></mjx-mo><mjx-mtext class=\"mjx-n\"><mjx-c class=\"mjx-c4D\"></mjx-c><mjx-c class=\"mjx-c53\"></mjx-c><mjx-c class=\"mjx-c45\"></mjx-c></mjx-mtext><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c29\"></mjx-c></mjx-mo><mjx-TeXAtom texclass=\"ORD\"><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2F\"></mjx-c></mjx-mo></mjx-TeXAtom><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D44E TEX-I\"></mjx-c></mjx-mi></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo stretchy=\"false\">(</mo><msub><mtext>MS</mtext><mi>C</mi></msub><mo>+</mo><mo stretchy=\"false\">(</mo><mi>a</mi><mo>−</mo><mn>1</mn><mo stretchy=\"false\">)</mo><mtext>MSE</mtext><mo stretchy=\"false\">)</mo><mrow data-mjx-texclass=\"ORD\"><mo>/</mo></mrow><mi>a</mi></math></mjx-assistive-mml></mjx-container></span> is\nunbiased for it in the Latin square.</p>","file":"ch18-covariance-and-design/05-latin-squares-incomplete-blocks.html"}