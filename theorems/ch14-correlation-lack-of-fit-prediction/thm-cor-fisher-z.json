mjx-n\" space=\"3\"><mjx-c class=\"mjx-c2212\"></mjx-c></mjx-mo><mjx-mi class=\"mjx-i\" space=\"3\"><mjx-c class=\"mjx-c1D701 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c29\"></mjx-c></mjx-mo><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c2192\"></mjx-c></mjx-mo><mjx-TeXAtom space=\"4\" texclass=\"ORD\"><mjx-mi class=\"mjx-n\"><mjx-c class=\"mjx-c4E\"></mjx-c></mjx-mi></mjx-TeXAtom><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c28\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c30\"></mjx-c></mjx-mn><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2C\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\" space=\"2\"><mjx-c class=\"mjx-c31\"></mjx-c></mjx-mn><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c29\"></mjx-c></mjx-mo></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"block\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><msqrt><mi>n</mi></msqrt><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mo stretchy=\"false\">(</mo><mi>r</mi><mo>−</mo><mi>ρ</mi><mo stretchy=\"false\">)</mo><mo accent=\"false\" stretchy=\"false\">→</mo><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"normal\">N</mi></mrow><mrow data-mjx-texclass=\"OPEN\"><mo minsize=\"1.2em\" maxsize=\"1.2em\">(</mo></mrow><mn>0</mn><mo>,</mo><mo stretchy=\"false\">(</mo><mn>1</mn><mo>−</mo><msup><mi>ρ</mi><mn>2</mn></msup><msup><mo stretchy=\"false\">)</mo><mn>2</mn></msup><mrow data-mjx-texclass=\"CLOSE\"><mo minsize=\"1.2em\" maxsize=\"1.2em\">)</mo></mrow><mstyle scriptlevel=\"0\"><mspace width=\"2em\"></mspace></mstyle><mtext>and</mtext><mstyle scriptlevel=\"0\"><mspace width=\"2em\"></mspace></mstyle><msqrt><mi>n</mi></msqrt><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mo stretchy=\"false\">(</mo><mi>z</mi><mo>−</mo><mi>ζ</mi><mo stretchy=\"false\">)</mo><mo accent=\"false\" stretchy=\"false\">→</mo><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"normal\">N</mi></mrow><mo stretchy=\"false\">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy=\"false\">)</mo></math></mjx-assistive-mml></mjx-container></span> in distribution. The same limits hold with <span class=\"math inline\"><mjx-container class=\"MathJax\" jax=\"CHTML\" style=\"font-size: 113.1%; position: relative;\" data-tex=\"\\sqrt{n-3}\"><mjx-math class=\" MJX-TEX\" aria-hidden=\"true\"><mjx-msqrt><mjx-sqrt><mjx-surd><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c221A\"></mjx-c></mjx-mo></mjx-surd><mjx-box style=\"padding-top: 0.134em;\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D45B TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\" space=\"3\"><mjx-c class=\"mjx-c2212\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\" space=\"3\"><mjx-c class=\"mjx-c33\"></mjx-c></mjx-mn></mjx-box></mjx-sqrt></mjx-msqrt></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msqrt><mi>n</mi><mo>−</mo><mn>3</mn></msqrt></math></mjx-assistive-mml></mjx-container></span> in place of <span class=\"math inline\"><mjx-container class=\"MathJax\" jax=\"CHTML\" style=\"font-size: 113.1%; position: relative;\" data-tex=\"\\sqrt n\"><mjx-math class=\" MJX-TEX\" aria-hidden=\"true\"><mjx-msqrt><mjx-sqrt><mjx-surd><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c221A\"></mjx-c></mjx-mo></mjx-surd><mjx-box style=\"padding-top: 0.281em;\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D45B TEX-I\"></mjx-c></mjx-mi></mjx-box></mjx-sqrt></mjx-msqrt></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msqrt><mi>n</mi></msqrt></math></mjx-assistive-mml></mjx-container></span>. The limiting variance of <span class=\"math inline\"><mjx-container class=\"MathJax\" jax=\"CHTML\" style=\"font-size: 113.1%; position: relative;\" data-tex=\"z\"><mjx-math class=\" MJX-TEX\" aria-hidden=\"true\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D467 TEX-I\"></mjx-c></mjx-mi></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>z</mi></math></mjx-assistive-mml></mjx-container></span> does not depend on <span class=\"math inline\"><mjx-container class=\"MathJax\" jax=\"CHTML\" style=\"font-size: 113.1%; position: relative;\" data-tex=\"\\rho\"><mjx-math class=\" MJX-TEX\" aria-hidden=\"true\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D70C TEX-I\"></mjx-c></mjx-mi></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>ρ</mi></math></mjx-assistive-mml></mjx-container></span>: <span class=\"math inline\"><mjx-container class=\"MathJax\" jax=\"CHTML\" style=\"font-size: 113.1%; position: relative;\" data-tex=\"\\tanh^{-1}\"><mjx-math class=\" MJX-TEX\" aria-hidden=\"true\"><mjx-msup><mjx-mi class=\"mjx-n\"><mjx-c class=\"mjx-c74\"></mjx-c><mjx-c class=\"mjx-c61\"></mjx-c><mjx-c class=\"mjx-c6E\"></mjx-c><mjx-c class=\"mjx-c68\"></mjx-c></mjx-mi><mjx-script style=\"vertical-align: 0.421em;\"><mjx-TeXAtom size=\"s\" texclass=\"ORD\"><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2212\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c31\"></mjx-c></mjx-mn></mjx-TeXAtom></mjx-script></mjx-msup></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>tanh</mi><mrow data-mjx-texclass=\"ORD\"><mo>−</mo><mn>1</mn></mrow></msup></math></mjx-assistive-mml></mjx-container></span> is a variance-stabilizing\ntransformation for <span class=\"math inline\"><mjx-container class=\"MathJax\" jax=\"CHTML\" style=\"font-size: 113.1%; position: relative;\" data-tex=\"r\"><mjx-math class=\" MJX-TEX\" aria-hidden=\"true\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D45F TEX-I\"></mjx-c></mjx-mi></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>r</mi></math></mjx-assistive-mml></mjx-container></span>.</p>","file":"ch14-correlation-lack-of-fit-prediction/04-correlation-coefficient.html"}