se\"><mjx-mo class=\"mjx-sop\"><mjx-c class=\"mjx-c2211 TEX-S1\"></mjx-c></mjx-mo><mjx-script style=\"vertical-align: -0.285em;\"><mjx-mi class=\"mjx-i\" size=\"s\"><mjx-c class=\"mjx-c1D456 TEX-I\"></mjx-c></mjx-mi></mjx-script></mjx-munder><mjx-mi class=\"mjx-n\" space=\"2\"><mjx-c class=\"mjx-c72\"></mjx-c><mjx-c class=\"mjx-c61\"></mjx-c><mjx-c class=\"mjx-c6E\"></mjx-c><mjx-c class=\"mjx-c6B\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c28\"></mjx-c></mjx-mo><mjx-msub><mjx-TeXAtom texclass=\"ORD\"><mjx-mi class=\"mjx-b\"><mjx-c class=\"mjx-c1D400 TEX-B\"></mjx-c></mjx-mi></mjx-TeXAtom><mjx-script style=\"vertical-align: -0.15em;\"><mjx-mi class=\"mjx-i\" size=\"s\"><mjx-c class=\"mjx-c1D456 TEX-I\"></mjx-c></mjx-mi></mjx-script></mjx-msub><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c29\"></mjx-c></mjx-mo></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>rank</mi><mo stretchy=\"false\">(</mo><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">A</mi></mrow><mo stretchy=\"false\">)</mo><mo>=</mo><munder><mo data-mjx-texclass=\"OP\">∑</mo><mi>i</mi></munder><mi>rank</mi><mo stretchy=\"false\">(</mo><msub><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">A</mi></mrow><mi>i</mi></msub><mo stretchy=\"false\">)</mo></math></mjx-assistive-mml></mjx-container></span>.</p></li>\n</ol>\n</div>\n<p>Then any two of (a), (b), (c) imply all four, and (c) together with\n(d) implies all four.</p>","file":"ch04-quadratic-forms/05-cochran.html"}