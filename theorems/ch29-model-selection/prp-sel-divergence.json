=\"vertical-align: -0.285em;\"><mjx-mi class=\"mjx-i\" size=\"s\"><mjx-c class=\"mjx-c1D456 TEX-I\"></mjx-c></mjx-mi></mjx-script></mjx-munder><mjx-mi class=\"mjx-i\" space=\"2\"><mjx-c class=\"mjx-c1D715\"></mjx-c></mjx-mi><mjx-msub><mjx-TeXAtom texclass=\"ORD\"><mjx-mover><mjx-over style=\"padding-bottom: 0.105em; padding-left: 0.329em; margin-bottom: -0.531em;\"><mjx-mo class=\"mjx-n\" style=\"width: 0; margin-left: -0.25em;\"><mjx-c class=\"mjx-c5E\"></mjx-c></mjx-mo></mjx-over><mjx-base><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D707 TEX-I\"></mjx-c></mjx-mi></mjx-base></mjx-mover></mjx-TeXAtom><mjx-script style=\"vertical-align: -0.15em;\"><mjx-mi class=\"mjx-i\" size=\"s\"><mjx-c class=\"mjx-c1D456 TEX-I\"></mjx-c></mjx-mi></mjx-script></mjx-msub><mjx-TeXAtom texclass=\"ORD\"><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2F\"></mjx-c></mjx-mo></mjx-TeXAtom><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D715\"></mjx-c></mjx-mi><mjx-msub><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D466 TEX-I\"></mjx-c></mjx-mi><mjx-script style=\"vertical-align: -0.15em;\"><mjx-mi class=\"mjx-i\" size=\"s\"><mjx-c class=\"mjx-c1D456 TEX-I\"></mjx-c></mjx-mi></mjx-script></mjx-msub></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mover><mtext>err</mtext><mo accent=\"true\">―</mo></mover><mo>+</mo><mn>2</mn><msup><mi>σ</mi><mn>2</mn></msup><msup><mi>n</mi><mrow data-mjx-texclass=\"ORD\"><mo>−</mo><mn>1</mn></mrow></msup><munder><mo data-mjx-texclass=\"OP\">∑</mo><mi>i</mi></munder><mi>∂</mi><msub><mrow data-mjx-texclass=\"ORD\"><mover><mi>μ</mi><mo stretchy=\"false\">^</mo></mover></mrow><mi>i</mi></msub><mrow data-mjx-texclass=\"ORD\"><mo>/</mo></mrow><mi>∂</mi><msub><mi>y</mi><mi>i</mi></msub></math></mjx-assistive-mml></mjx-container></span> is an unbiased estimate of <span class=\"math inline\"><mjx-container class=\"MathJax\" jax=\"CHTML\" style=\"font-size: 113.1%; position: relative;\" data-tex=\"\\operatorname{E}(\\text{Err}_{\\text{in}})\"><mjx-math class=\" MJX-TEX\" aria-hidden=\"true\"><mjx-mi class=\"mjx-n\"><mjx-c class=\"mjx-c45\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c28\"></mjx-c></mjx-mo><mjx-msub><mjx-mtext class=\"mjx-n\"><mjx-c class=\"mjx-c45\"></mjx-c><mjx-c class=\"mjx-c72\"></mjx-c><mjx-c class=\"mjx-c72\"></mjx-c></mjx-mtext><mjx-script style=\"vertical-align: -0.15em;\"><mjx-TeXAtom size=\"s\" texclass=\"ORD\"><mjx-mtext class=\"mjx-n\"><mjx-c class=\"mjx-c69\"></mjx-c><mjx-c class=\"mjx-c6E\"></mjx-c></mjx-mtext></mjx-TeXAtom></mjx-script></mjx-msub><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c29\"></mjx-c></mjx-mo></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi data-mjx-texclass=\"OP\" mathvariant=\"normal\">E</mi><mo stretchy=\"false\">(</mo><msub><mtext>Err</mtext><mrow data-mjx-texclass=\"ORD\"><mtext>in</mtext></mrow></msub><mo stretchy=\"false\">)</mo></math></mjx-assistive-mml></mjx-container></span> that does not\ninvolve <span class=\"math inline\"><mjx-container class=\"MathJax\" jax=\"CHTML\" style=\"font-size: 113.1%; position: relative;\" data-tex=\"\\boldsymbol{\\upmu}\"><mjx-math class=\" MJX-TEX\" aria-hidden=\"true\"><mjx-mi class=\"mjx-b\"><mjx-utext style=\"font-size: 88.4%; padding: 0.848em 0 0.226em 0;\" variant=\"bold\">𝛍</mjx-utext></mjx-mi></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"bold\">μ</mi></math></mjx-assistive-mml></mjx-container></span>.</p>","file":"ch29-model-selection/01-prediction-error.html"}