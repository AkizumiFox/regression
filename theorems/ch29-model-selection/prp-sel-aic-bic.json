jx-mo><mjx-mi class=\"mjx-b\" space=\"3\"><mjx-utext style=\"font-size: 88.4%; padding: 0.848em 0 0.226em 0;\" variant=\"bold\">𝛍</mjx-utext></mjx-mi><mjx-msup><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2016\"></mjx-c></mjx-mo><mjx-script style=\"vertical-align: 0.363em;\"><mjx-mn class=\"mjx-n\" size=\"s\"><mjx-c class=\"mjx-c32\"></mjx-c></mjx-mn></mjx-script></mjx-msup></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><munder><mo data-mjx-texclass=\"OP\" movablelimits=\"true\">min</mo><mi>k</mi></munder><mo data-mjx-texclass=\"OPEN\" fence=\"false\" stretchy=\"false\">‖</mo><msub><mrow data-mjx-texclass=\"ORD\"><mover><mi mathvariant=\"bold\">μ</mi><mo stretchy=\"false\">^</mo></mover></mrow><mi>k</mi></msub><mo>−</mo><mi mathvariant=\"bold\">μ</mi><msup><mo data-mjx-texclass=\"CLOSE\" fence=\"false\" stretchy=\"false\">‖</mo><mn>2</mn></msup></math></mjx-assistive-mml></mjx-container></span> tends to\none in probability (Shibata 1981; Li 1987). A criterion with <span class=\"math inline\"><mjx-container class=\"MathJax\" jax=\"CHTML\" style=\"font-size: 113.1%; position: relative;\" data-tex=\"c_n\\to\\infty\"><mjx-math class=\" MJX-TEX\" aria-hidden=\"true\"><mjx-msub><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D450 TEX-I\"></mjx-c></mjx-mi><mjx-script style=\"vertical-align: -0.15em;\"><mjx-mi class=\"mjx-i\" size=\"s\"><mjx-c class=\"mjx-c1D45B TEX-I\"></mjx-c></mjx-mi></mjx-script></mjx-msub><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c2192\"></mjx-c></mjx-mo><mjx-mi class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c221E\"></mjx-c></mjx-mi></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msub><mi>c</mi><mi>n</mi></msub><mo accent=\"false\" stretchy=\"false\">→</mo><mi mathvariant=\"normal\">∞</mi></math></mjx-assistive-mml></mjx-container></span> does not have this property\nin general.</p></li>\n</ol>\n</div>","file":"ch29-model-selection/02-cp-aic-bic.html"}