-mn class=\"mjx-n\"><mjx-c class=\"mjx-c31\"></mjx-c></mjx-mn></mjx-TeXAtom></mjx-script></mjx-msub></mjx-TeXAtom></mjx-script></mjx-msup><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2E\"></mjx-c></mjx-mo></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"block\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><munderover><mo data-mjx-texclass=\"OP\">∏</mo><mrow data-mjx-texclass=\"ORD\"><mi>r</mi><mo>=</mo><mn>1</mn></mrow><mrow data-mjx-texclass=\"ORD\"><mi>c</mi></mrow></munderover><msubsup><mi>π</mi><mrow data-mjx-texclass=\"ORD\"><mi>i</mi><mi>r</mi></mrow><mrow data-mjx-texclass=\"ORD\"><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><msub><mi>y</mi><mrow data-mjx-texclass=\"ORD\"><mi>i</mi><mi>r</mi></mrow></msub></mrow></msubsup><mo>=</mo><munderover><mo data-mjx-texclass=\"OP\">∏</mo><mrow data-mjx-texclass=\"ORD\"><mi>r</mi><mo>=</mo><mn>1</mn></mrow><mrow data-mjx-texclass=\"ORD\"><mi>c</mi><mo>−</mo><mn>1</mn></mrow></munderover><msubsup><mi>δ</mi><mrow data-mjx-texclass=\"ORD\"><mi>i</mi><mi>r</mi></mrow><mrow data-mjx-texclass=\"ORD\"><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><msub><mi>y</mi><mrow data-mjx-texclass=\"ORD\"><mi>i</mi><mi>r</mi></mrow></msub></mrow></msubsup><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mo stretchy=\"false\">(</mo><mn>1</mn><mo>−</mo><msub><mi>δ</mi><mrow data-mjx-texclass=\"ORD\"><mi>i</mi><mi>r</mi></mrow></msub><msup><mo stretchy=\"false\">)</mo><mrow data-mjx-texclass=\"ORD\"><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><msub><mi>R</mi><mrow data-mjx-texclass=\"ORD\"><mi>i</mi><mo>,</mo><mi>r</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow></msup><mo>.</mo></math></mjx-assistive-mml></mjx-container></span>{#eq-mlt-factorization}</p>\n<p>Consequently:</p>\n<div class=\"enumerate\" data-options=\"label=(\\alph*)\">\n<ol type=\"1\">\n<li><p>the log-likelihood is <span class=\"math inline\"><mjx-c