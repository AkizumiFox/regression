c1D417 TEX-B\"></mjx-c></mjx-mi></mjx-TeXAtom></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">S</mi></mrow><mo>=</mo><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">C</mi></mrow><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">D</mi></mrow><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">X</mi></mrow></math></mjx-assistive-mml></mjx-container></span>.</p></li>\n<li><p><span class=\"math inline\"><mjx-container class=\"MathJax\" jax=\"CHTML\" style=\"font-size: 113.1%; position: relative;\" data-tex=\"\\boldsymbol{\\mathcal\nJ}(\\mathbf{g})\\preceq\\phi^{-1}\\mathbf{X}^{\\top}\\mathbf{W}\\mathbf{X} =\\boldsymbol{\\mathcal\nJ}(\\mathbf{U})\"><mjx-math class=\" MJX-TEX\" aria-hidden=\"true\"><mjx-TeXAtom texclass=\"ORD\"><mjx-mi class=\"mjx-cal mjx-b\"><mjx-c class=\"mjx-c4A TEX-CB\"></mjx-c></mjx-mi></mjx-TeXAtom><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c28\"></mjx-c></mjx-mo><mjx-TeXAtom texclass=\"ORD\"><mjx-mi class=\"mjx-b\"><mjx-c class=\"mjx-c1D420 TEX-B\"></mjx-c></mjx-mi></mjx-TeXAtom><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c29\"></mjx-c></mjx-mo><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c2AAF\"></mjx-c></mjx-mo><mjx-msup space=\"4\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D719 TEX-I\"></mjx-c></mjx-mi><mjx-script style=\"vertical-align: 0.363em;\"><mjx-TeXAtom size=\"s\" texclass=\"ORD\"><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2212\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c31\"></mjx-c></mjx-mn></mjx-TeXAtom></mjx-script></mjx-msup><mjx-msup><mjx-TeXAtom texclass=\"ORD\"><mjx-mi class=\"mjx-b\"><mjx-c class=\"mjx-c1D417 TEX-B\"></mjx-c></mjx-mi></mjx-TeXAtom><mjx-script style=\"vertical-align: 0.363em;\"><mjx-TeXAtom size=\"s\" texclass=\"ORD\"><mjx-mi class=\"mjx-n\"><mjx-c class=\"mjx-c22A4\"></mjx-c></mjx-mi></mjx-TeXAtom></mjx-script></mjx-msup><mjx-TeXAtom texclass=\"ORD\"><mjx-mi class=\"mjx-b\"><mjx-c class=\"mjx-c1D416 TEX-B\"></mjx-c></mjx-mi></mjx-TeXAtom><mjx-TeXAtom texclass=\"ORD\"><mjx-mi class=\"mjx-b\"><mjx-c class=\"mjx-c1D417 TEX-B\"></mjx-c></mjx-mi></mjx-TeXAtom><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3D\"></mjx-c></mjx-mo><mjx-TeXAtom space=\"4\" texclass=\"ORD\"><mjx-mi class=\"mjx-cal mjx-b\"><mjx-c class=\"mjx-c4A TEX-CB\"></mjx-c></mjx-mi></mjx-TeXAtom><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c28\"></mjx-c></mjx-mo><mjx-TeXAtom texclass=\"ORD\"><mjx-mi class=\"mjx-b\"><mjx-c class=\"mjx-c1D414 TEX-B\"></mjx-c></mjx-mi></mjx-TeXAtom><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c29\"></mjx-c></mjx-mo></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow data-mjx-texclass=\"ORD\"><mi data-mjx-variant=\"-tex-bold-calligraphic\" mathvariant=\"bold-script\">J</mi></mrow><mo stretchy=\"false\">(</mo><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">g</mi></mrow><mo stretchy=\"false\">)</mo><mo>⪯</mo><msup><mi>ϕ</mi><mrow data-mjx-texclass=\"ORD\"><mo>−</mo><mn>1</mn></mrow></msup><msup><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">X</mi></mrow><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"normal\">⊤</mi></mrow></msup><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">W</mi></mrow><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">X</mi></mrow><mo>=</mo><mrow data-mjx-texclass=\"ORD\"><mi data-mjx-variant=\"-tex-bold-calligraphic\" mathvariant=\"bold-script\">J</mi></mrow><mo stretchy=\"false\">(</mo><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">U</mi></mrow><mo stretchy=\"false\">)</mo></math></mjx-assistive-mml></mjx-container></span> in the order of nonnegative definiteness, for every\nlinear estimating function <span class=\"math inline\"><mjx-container class=\"MathJax\" jax=\"CHTML\" style=\"font-size: 113.1%; position: relative;\" data-tex=\"\\mathbf{g}\"><mjx-math class=\" MJX-TEX\" aria-hidden=\"true\"><mjx-TeXAtom texclass=\"ORD\"><mjx-mi class=\"mjx-b\"><mjx-c class=\"mjx-c1D420 TEX-B\"></mjx-c></mjx-mi></mjx-TeXAtom></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">g</mi></mrow></math></mjx-assistive-mml></mjx-container></span>.</p></li>\n<li><p>Equality holds if and only if <span class=\"math inline\"><mjx-container class=\"MathJax\" jax=\"CHTML\" style=\"font-size: 113.1%; position: relative;\" data-tex=\"\\mathbf{C}^{\\top}=\\boldsymbol{\\Sigma}^{-1}\\mathbf{D}\\mathbf{X}\\,\\mathbf{N}\"><mjx-math class=\" MJX-TEX\" aria-hidden=\"true\"><mjx-msup><mjx-TeXAtom texclass=\"ORD\"><mjx-mi class=\"mjx-b\"><mjx-c class=\"mjx-c1D402 TEX-B\"></mjx-c></mjx-mi></mjx-TeXAtom><mjx-script style=\"vertical-align: 0.363em;\"><mjx-TeXAtom size=\"s\" texclass=\"ORD\"><mjx-mi class=\"mjx-n\"><mjx-c class=\"mjx-c22A4\"></mjx-c></mjx-mi></mjx-TeXAtom></mjx-script></mjx-msup><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3D\"></mjx-c></mjx-mo><mjx-msup space=\"4\"><mjx-mi class=\"mjx-b\"><mjx-c class=\"mjx-c1D6BA TEX-B\"></mjx-c></mjx-mi><mjx-script style=\"vertical-align: 0.363em;\"><mjx-TeXAtom size=\"s\" texclass=\"ORD\"><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2212\"></mjx-c></mjx-mo><mjx-mn class=\"mjx-n\"><mjx-c class=\"mjx-c31\"></mjx-c></mjx-mn></mjx-TeXAtom></mjx-script></mjx-msup><mjx-TeXAtom texclass=\"ORD\"><mjx-mi class=\"mjx-b\"><mjx-c class=\"mjx-c1D403 TEX-B\"></mjx-c></mjx-mi></mjx-TeXAtom><mjx-TeXAtom texclass=\"ORD\"><mjx-mi class=\"mjx-b\"><mjx-c class=\"mjx-c1D417 TEX-B\"></mjx-c></mjx-mi></mjx-TeXAtom><mjx-mstyle><mjx-mspace style=\"width: 0.167em;\"></mjx-mspace></mjx-mstyle><mjx-TeXAtom texclass=\"ORD\"><mjx-mi class=\"mjx-b\"><mjx-c class=\"mjx-c1D40D TEX-B\"></mjx-c></mjx-mi></mjx-TeXAtom></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">C</mi></mrow><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"normal\">⊤</mi></mrow></msup><mo>=</mo><msup><mi mathvariant=\"bold\">Σ</mi><mrow data-mjx-texclass=\"ORD\"><mo>−</mo><mn>1</mn></mrow></msup><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">D</mi></mrow><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">X</mi></mrow><mstyle scriptlevel=\"0\"><mspace width=\"0.167em\"></mspace></mstyle><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">N</mi></mrow></math></mjx-assistive-mml></mjx-container></span>\nfor a nonsingular <span class=\"math inline\"><mjx-container class=\"MathJax\" jax=\"CHTML\" style=\"font-size: 113.1%; position: relative;\" data-tex=\"p\\times p\"><mjx-math class=\" MJX-TEX\" aria-hidden=\"true\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D45D TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\" space=\"3\"><mjx-c class=\"mjx-cD7\"></mjx-c></mjx-mo><mjx-mi class=\"mjx-i\" space=\"3\"><mjx-c class=\"mjx-c1D45D TEX-I\"></mjx-c></mjx-mi></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>p</mi><mo>×</mo><mi>p</mi></math></mjx-assistive-mml></mjx-container></span> matrix\n<span class=\"math inline\"><mjx-container class=\"MathJax\" jax=\"CHTML\" style=\"font-size: 113.1%; position: relative;\" data-tex=\"\\mathbf{N}\"><mjx-math class=\" MJX-TEX\" aria-hidden=\"true\"><mjx-TeXAtom texclass=\"ORD\"><mjx-mi class=\"mjx-b\"><mjx-c class=\"mjx-c1D40D TEX-B\"></mjx-c></mjx-mi></mjx-TeXAtom></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">N</mi></mrow></math></mjx-assistive-mml></mjx-container></span>, with <span class=\"math inline\"><mjx-container class=\"MathJax\" jax=\"CHTML\" style=\"font-size: 113.1%; position: relative;\" data-tex=\"\\boldsymbol{\\Sigma}=\\operatorname{Cov}(\\mathbf{Y})\"><mjx-math class=\" MJX-TEX\" aria-hidden=\"true\"><mjx-mi class=\"mjx-b\"><mjx-c class=\"mjx-c1D6BA TEX-B\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3D\"></mjx-c></mjx-mo><mjx-mi class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c43\"></mjx-c><mjx-c class=\"mjx-c6F\"></mjx-c><mjx-c class=\"mjx-c76\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c28\"></mjx-c></mjx-mo><mjx-TeXAtom texclass=\"ORD\"><mjx-mi class=\"mjx-b\"><mjx-c class=\"mjx-c1D418 TEX-B\"></mjx-c></mjx-mi></mjx-TeXAtom><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c29\"></mjx-c></mjx-mo></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"bold\">Σ</mi><mo>=</mo><mi>Cov</mi><mo stretchy=\"false\">(</mo><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">Y</mi></mrow><mo stretchy=\"false\">)</mo></math></mjx-assistive-mml></mjx-container></span>: the coefficients are\nthose of the quasi-score up to one common nonsingular transformation,\nand <span class=\"math inline\"><mjx-container class=\"MathJax\" jax=\"CHTML\" style=\"font-size: 113.1%; position: relative;\" data-tex=\"\\mathbf{g}\"><mjx-math class=\" MJX-TEX\" aria-hidden=\"true\"><mjx-TeXAtom texclass=\"ORD\"><mjx-mi class=\"mjx-b\"><mjx-c class=\"mjx-c1D420 TEX-B\"></mjx-c></mjx-mi></mjx-TeXAtom></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">g</mi></mrow></math></mjx-assistive-mml></mjx-container></span> then has the same\nroots as <span class=\"math inline\"><mjx-container class=\"MathJax\" jax=\"CHTML\" style=\"font-size: 113.1%; position: relative;\" data-tex=\"\\mathbf{U}\"><mjx-math class=\" MJX-TEX\" aria-hidden=\"true\"><mjx-TeXAtom texclass=\"ORD\"><mjx-mi class=\"mjx-b\"><mjx-c class=\"mjx-c1D414 TEX-B\"></mjx-c></mjx-mi></mjx-TeXAtom></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">U</mi></mrow></math></mjx-assistive-mml></mjx-container></span>.</p></li>\n</ol>\n</div>","file":"ch38-quasi-likelihood/02-estimating-equations.html"}