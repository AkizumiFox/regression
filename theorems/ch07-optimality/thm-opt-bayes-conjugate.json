=\"mjx-n\"><mjx-c class=\"mjx-c2C\"></mjx-c></mjx-mo><mjx-msub space=\"2\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D44F TEX-I\"></mjx-c></mjx-mi><mjx-script style=\"vertical-align: -0.15em;\"><mjx-mi class=\"mjx-i\" size=\"s\"><mjx-c class=\"mjx-c1D45B TEX-I\"></mjx-c></mjx-mi></mjx-script></mjx-msub><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c29\"></mjx-c></mjx-mo></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mtext>NIG</mtext><mo stretchy=\"false\">(</mo><msub><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">m</mi></mrow><mi>n</mi></msub><mo>,</mo><msub><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">V</mi></mrow><mi>n</mi></msub><mo>,</mo><msub><mi>a</mi><mi>n</mi></msub><mo>,</mo><msub><mi>b</mi><mi>n</mi></msub><mo stretchy=\"false\">)</mo></math></mjx-assistive-mml></mjx-container></span>,\nwhere <span class=\"math display\"><mjx-container class=\"MathJax\" jax=\"CHTML\" style=\"font-size: 113.1%; position: relative;\" display=\"true\" data-tex=\"\n\\begin{aligned}\n\\mathbf{V}_n&=(\\mathbf{V}_0^{-1}+\\mathbf{X}^{\\top}\\mathbf{X})^{-1},\\qquad\n\\mathbf{m}_n=\\mathbf{V}_n(\\mathbf{V}_0^{-1}\\mathbf{m}_0+\\mathbf{X}^{\\top}\\mathbf{y}),\\\\\na_n&=a_0+\\frac n2,\n\\end{aligned}\n\"><mjx-math display=\"true\" style=\"margin-left: 0; margin-right: 0;\" class=\" MJX-TEX\" aria-hidden=\"true\"><mjx-mtable style=\"min-width: 24.181em;\"><mjx-table><mjx-itable><mjx-mtr><mjx-mtd style=\"text-align: right; padding-right: 0; padding-bottom: 0.15em;\"><mjx-msub><mjx-TeXAtom texclass=\"ORD\"><mjx-mi class=\"mjx-b\"><mjx-c class=\"mjx-c1D415 TEX-B\"></mjx-c></mjx-mi></mjx-TeXAtom><mjx-script style=\"vertical-align: -0.15em;\"><mjx-mi class=\"mjx-i\" size=\"s\"><mjx-c class=\"mjx-c1D45B TEX-I\"></mjx-c></mjx-mi></mjx-script></mjx-msub><mjx-tstrut></mjx-tstrut></mjx-mtd><mjx-mtd style=\"text-align: left; padding-left: 0; padding-bottom: 0.15em;\"><mjx-mi class=\"mjx-n\"></mjx-mi><