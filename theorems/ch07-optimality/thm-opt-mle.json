-TeXAtom texclass=\"ORD\"><mjx-mover><mjx-over style=\"padding-bottom: 0.105em; padding-left: 0.265em; margin-bottom: -0.215em;\"><mjx-mo class=\"mjx-n\" style=\"width: 0; margin-left: -0.25em;\"><mjx-c class=\"mjx-c7E\"></mjx-c></mjx-mo></mjx-over><mjx-base><mjx-mi class=\"mjx-b\"><mjx-utext style=\"font-size: 88.4%; padding: 0.848em 0 0.226em 0;\" variant=\"bold\">𝛃</mjx-utext></mjx-mi></mjx-base></mjx-mover></mjx-TeXAtom><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c2C\"></mjx-c></mjx-mo><mjx-msup space=\"2\"><mjx-TeXAtom texclass=\"ORD\"><mjx-mover><mjx-over style=\"padding-bottom: 0.105em; padding-left: 0.285em; margin-bottom: -0.215em;\"><mjx-mo class=\"mjx-n\" style=\"width: 0; margin-left: -0.25em;\"><mjx-c class=\"mjx-c7E\"></mjx-c></mjx-mo></mjx-over><mjx-base><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D70E TEX-I\"></mjx-c></mjx-mi></mjx-base></mjx-mover></mjx-TeXAtom><mjx-script style=\"vertical-align: 0.363em;\"><mjx-mn class=\"mjx-n\" size=\"s\"><mjx-c class=\"mjx-c32\"></mjx-c></mjx-mn></mjx-script></mjx-msup><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c29\"></mjx-c></mjx-mo></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo stretchy=\"false\">(</mo><mrow data-mjx-texclass=\"ORD\"><mover><mi mathvariant=\"bold\">β</mi><mo stretchy=\"false\">~</mo></mover></mrow><mo>,</mo><msup><mrow data-mjx-texclass=\"ORD\"><mover><mi>σ</mi><mo stretchy=\"false\">~</mo></mover></mrow><mn>2</mn></msup><mo stretchy=\"false\">)</mo></math></mjx-assistive-mml></mjx-container></span>\nmaximizes the likelihood iff <span class=\"math inline\"><mjx-container class=\"MathJax\" jax=\"CHTML\" style=\"font-size: 113.1%; position: relative;\" data-tex=\"\\tilde{\\boldsymbol{\\upbeta}}\"><mjx-math class=\" MJX-TEX\" aria-hidden=\"true\"><mjx-TeXAtom texclass=\"ORD\"><mjx-mover><mjx-over style=\"padding-bottom: 0.105em; padding-left: 0.265em; margin-bottom: -0.215em;\"><mjx-mo class=\"mjx-n\" style=\"width: 0; m