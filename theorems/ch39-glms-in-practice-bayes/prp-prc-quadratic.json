n>1</mn></mrow></msup><munder><mo data-mjx-texclass=\"OP\">∑</mo><mi>i</mi></munder><msub><mi>w</mi><mi>i</mi></msub><mo fence=\"false\" stretchy=\"false\">{</mo><msub><mi>y</mi><mi>i</mi></msub><msub><mi>θ</mi><mi>i</mi></msub><mo>−</mo><mi>b</mi><mo stretchy=\"false\">(</mo><msub><mi>θ</mi><mi>i</mi></msub><mo stretchy=\"false\">)</mo><mo fence=\"false\" stretchy=\"false\">}</mo><mo>+</mo><mi>c</mi></math></mjx-assistive-mml></mjx-container></span>.\nSuppose <span class=\"math inline\"><mjx-container class=\"MathJax\" jax=\"CHTML\" style=\"font-size: 113.1%; position: relative;\" data-tex=\"b\"><mjx-math class=\" MJX-TEX\" aria-hidden=\"true\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D44F TEX-I\"></mjx-c></mjx-mi></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>b</mi></math></mjx-assistive-mml></mjx-container></span> is twice continuously\ndifferentiable on an open interval <span class=\"math inline\"><mjx-container class=\"MathJax\" jax=\"CHTML\" style=\"font-size: 113.1%; position: relative;\" data-tex=\"\\Theta\"><mjx-math class=\" MJX-TEX\" aria-hidden=\"true\"><mjx-mi class=\"mjx-n\"><mjx-c class=\"mjx-c398\"></mjx-c></mjx-mi></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">Θ</mi></math></mjx-assistive-mml></mjx-container></span>. Then the following are\nequivalent.</p>\n<div class=\"enumerate\" data-options=\"label=(\\alph*)\">\n<ol type=\"1\">\n<li><p>For every <span class=\"math inline\"><mjx-container class=\"MathJax\" jax=\"CHTML\" style=\"font-size: 113.1%; position: relative;\" data-tex=\"n\"><mjx-math class=\" MJX-TEX\" aria-hidden=\"true\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D45B TEX-I\"></mjx-c></mjx-mi></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>n</mi></math></mjx-assistive-mml></mjx-container></span>, every <span class=\"math inline\"><mjx-container class=\"MathJax\" jax=\"CHTML\" style=\"font-size: 113.1%; position: relative;\" data-tex=\"\\mathbf{X}\"><mjx-math class=\" MJX-TEX\" aria-hidden=\"true\"><mjx-TeXAtom texclass=\"ORD\"><mjx-mi class=\"mjx-b\"><mjx-c class=\"mjx-c1D417 TEX-B\"></mjx-c></mjx-mi></mjx-TeXAtom></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">X</mi></mrow></math></mjx-assistive-mml></mjx-container></span> with <span class=\"math inline\"><mjx-container class=\"MathJax\" jax=\"CHTML\" style=\"font-size: 113.1%; position: relative;\" data-tex=\"\\operatorname{rank}(\\mathbf{X})=p\"><mjx-math class=\" MJX-TEX\" aria-hidden=\"true\"><mjx-mi class=\"mjx-n\"><mjx-c class=\"mjx-c72\"></mjx-c><mjx-c class=\"mjx-c61\"></mjx-c><mjx-c class=\"mjx-c6E\"></mjx-c><mjx-c class=\"mjx-c6B\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c28\"></mjx-c></mjx-mo><mjx-TeXAtom texclass=\"ORD\"><mjx-mi class=\"mjx-b\"><mjx-c class=\"mjx-c1D417 TEX-B\"></mjx-c></mjx-mi></mjx-TeXAtom><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c29\"></mjx-c></mjx-mo><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3D\"></mjx-c></mjx-mo><mjx-mi class=\"mjx-i\" space=\"4\"><mjx-c class=\"mjx-c1D45D TEX-I\"></mjx-c></mjx-mi></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>rank</mi><mo stretchy=\"false\">(</mo><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">X</mi></mrow><mo stretchy=\"false\">)</mo><mo>=</mo><mi>p</mi></math></mjx-assistive-mml></mjx-container></span> and every <span class=\"math inline\"><mjx-container class=\"MathJax\" jax=\"CHTML\" style=\"font-size: 113.1%; position: relative;\" data-tex=\"\\mathbf{y}\"><mjx-math class=\" MJX-TEX\" aria-hidden=\"true\"><mjx-TeXAtom texclass=\"ORD\"><mjx-mi class=\"mjx-b\"><mjx-c class=\"mjx-c1D432 TEX-B\"></mjx-c></mjx-mi></mjx-TeXAtom></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">y</mi></mrow></math></mjx-assistive-mml></mjx-container></span>, the function <span class=\"math inline\"><mjx-container class=\"MathJax\" jax=\"CHTML\" style=\"font-size: 113.1%; position: relative;\" data-tex=\"\\boldsymbol{\\upbeta}\\mapsto\\ell(\\boldsymbol{\\upbeta})\"><mjx-math class=\" MJX-TEX\" aria-hidden=\"true\"><mjx-mi class=\"mjx-b\"><mjx-utext style=\"font-size: 88.4%; padding: 0.848em 0 0.226em 0;\" variant=\"bold\">𝛃</mjx-utext></mjx-mi><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c21A6\"></mjx-c></mjx-mo><mjx-mi class=\"mjx-i\" space=\"4\"><mjx-c class=\"mjx-c2113\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c28\"></mjx-c></mjx-mo><mjx-mi class=\"mjx-b\"><mjx-utext style=\"font-size: 88.4%; padding: 0.848em 0 0.226em 0;\" variant=\"bold\">𝛃</mjx-utext></mjx-mi><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c29\"></mjx-c></mjx-mo></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"bold\">β</mi><mo stretchy=\"false\">↦</mo><mi>ℓ</mi><mo stretchy=\"false\">(</mo><mi mathvariant=\"bold\">β</mi><mo stretchy=\"false\">)</mo></math></mjx-assistive-mml></mjx-container></span> is a quadratic\npolynomial on <span class=\"math inline\"><mjx-container class=\"MathJax\" jax=\"CHTML\" style=\"font-size: 113.1%; position: relative;\" data-tex=\"\\{\\boldsymbol{\\upbeta}:\\mathbf{x}_{(i)}^{\\top}\\boldsymbol{\\upbeta}\\in\\Theta\\}\"><mjx-math class=\" MJX-TEX\" aria-hidden=\"true\"><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c7B\"></mjx-c></mjx-mo><mjx-mi class=\"mjx-b\"><mjx-utext style=\"font-size: 88.4%; padding: 0.848em 0 0.226em 0;\" variant=\"bold\">𝛃</mjx-utext></mjx-mi><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3A\"></mjx-c></mjx-mo><mjx-msubsup space=\"4\"><mjx-TeXAtom texclass=\"ORD\"><mjx-mi class=\"mjx-b\"><mjx-c class=\"mjx-c1D431 TEX-B\"></mjx-c></mjx-mi></mjx-TeXAtom><mjx-script style=\"vertical-align: -0.347em; margin-left: 0;\"><mjx-TeXAtom size=\"s\" texclass=\"ORD\"><mjx-mi class=\"mjx-n\"><mjx-c class=\"mjx-c22A4\"></mjx-c></mjx-mi></mjx-TeXAtom><mjx-spacer style=\"margin-top: 0.18em;\"></mjx-spacer><mjx-TeXAtom size=\"s\" texclass=\"ORD\"><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c28\"></mjx-c></mjx-mo><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D456 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c29\"></mjx-c></mjx-mo></mjx-TeXAtom></mjx-script></mjx-msubsup><mjx-mi class=\"mjx-b\"><mjx-utext style=\"font-size: 88.4%; padding: 0.848em 0 0.226em 0;\" variant=\"bold\">𝛃</mjx-utext></mjx-mi><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c2208\"></mjx-c></mjx-mo><mjx-mi class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c398\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c7D\"></mjx-c></mjx-mo></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo fence=\"false\" stretchy=\"false\">{</mo><mi mathvariant=\"bold\">β</mi><mo>:</mo><msubsup><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"bold\">x</mi></mrow><mrow data-mjx-texclass=\"ORD\"><mo stretchy=\"false\">(</mo><mi>i</mi><mo stretchy=\"false\">)</mo></mrow><mrow data-mjx-texclass=\"ORD\"><mi mathvariant=\"normal\">⊤</mi></mrow></msubsup><mi mathvariant=\"bold\">β</mi><mo>∈</mo><mi mathvariant=\"normal\">Θ</mi><mo fence=\"false\" stretchy=\"false\">}</mo></math></mjx-assistive-mml></mjx-container></span>.</p></li>\n<li><p><span class=\"math inline\"><mjx-container class=\"MathJax\" jax=\"CHTML\" style=\"font-size: 113.1%; position: relative;\" data-tex=\"b''\"><mjx-math class=\" MJX-TEX\" aria-hidden=\"true\"><mjx-msup><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D44F TEX-I\"></mjx-c></mjx-mi><mjx-script style=\"vertical-align: 0.363em;\"><mjx-mo class=\"mjx-var\" size=\"s\"><mjx-c class=\"mjx-c2033\"></mjx-c></mjx-mo></mjx-script></mjx-msup></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mi>b</mi><mo data-mjx-alternate=\"1\">″</mo></msup></math></mjx-assistive-mml></mjx-container></span> is constant on\n<span class=\"math inline\"><mjx-container class=\"MathJax\" jax=\"CHTML\" style=\"font-size: 113.1%; position: relative;\" data-tex=\"\\Theta\"><mjx-math class=\" MJX-TEX\" aria-hidden=\"true\"><mjx-mi class=\"mjx-n\"><mjx-c class=\"mjx-c398\"></mjx-c></mjx-mi></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"normal\">Θ</mi></math></mjx-assistive-mml></mjx-container></span>.</p></li>\n<li><p>The variance function is constant: <span class=\"math inline\"><mjx-container class=\"MathJax\" jax=\"CHTML\" style=\"font-size: 113.1%; position: relative;\" data-tex=\"V(\\mu)=b''(\\theta)\"><mjx-math class=\" MJX-TEX\" aria-hidden=\"true\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D449 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c28\"></mjx-c></mjx-mo><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D707 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c29\"></mjx-c></mjx-mo><mjx-mo class=\"mjx-n\" space=\"4\"><mjx-c class=\"mjx-c3D\"></mjx-c></mjx-mo><mjx-msup space=\"4\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D44F TEX-I\"></mjx-c></mjx-mi><mjx-script style=\"vertical-align: 0.363em;\"><mjx-mo class=\"mjx-var\" size=\"s\"><mjx-c class=\"mjx-c2033\"></mjx-c></mjx-mo></mjx-script></mjx-msup><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c28\"></mjx-c></mjx-mo><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D703 TEX-I\"></mjx-c></mjx-mi><mjx-mo class=\"mjx-n\"><mjx-c class=\"mjx-c29\"></mjx-c></mjx-mo></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>V</mi><mo stretchy=\"false\">(</mo><mi>μ</mi><mo stretchy=\"false\">)</mo><mo>=</mo><msup><mi>b</mi><mo data-mjx-alternate=\"1\">″</mo></msup><mo stretchy=\"false\">(</mo><mi>θ</mi><mo stretchy=\"false\">)</mo></math></mjx-assistive-mml></mjx-container></span> does not\ndepend on <span class=\"math inline\"><mjx-container class=\"MathJax\" jax=\"CHTML\" style=\"font-size: 113.1%; position: relative;\" data-tex=\"\\mu\"><mjx-math class=\" MJX-TEX\" aria-hidden=\"true\"><mjx-mi class=\"mjx-i\"><mjx-c class=\"mjx-c1D707 TEX-I\"></mjx-c></mjx-mi></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>μ</mi></math></mjx-assistive-mml></mjx-container></span>, so the family is\nnormal (<span class=\"citation\" data-cites=\"exr-glm-variance-determines\">@exr-glm-variance-determines</span>).</p></li>\n</ol>\n</div>\n<p>Consequently, for every family except the normal, a normal prior on\n<span class=\"math inline\"><mjx-container class=\"MathJax\" jax=\"CHTML\" style=\"font-size: 113.1%; position: relative;\" data-tex=\"\\boldsymbol{\\upbeta}\"><mjx-math class=\" MJX-TEX\" aria-hidden=\"true\"><mjx-mi class=\"mjx-b\"><mjx-utext style=\"font-size: 88.4%; padding: 0.848em 0 0.226em 0;\" variant=\"bold\">𝛃</mjx-utext></mjx-mi></mjx-math><mjx-assistive-mml unselectable=\"on\" display=\"inline\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi mathvariant=\"bold\">β</mi></math></mjx-assistive-mml></mjx-container></span> gives a posterior that is\nnot normal and has no closed-form normalizing constant.</p>","file":"ch39-glms-in-practice-bayes/03-bayesian-linear-revisited.html"}