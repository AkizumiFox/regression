{
    "title": "Regression: From Projection to Distribution",
    "author": "Akizumi",
    "output": {
        "html": "_build/html",
        "pdf": "_build/pdf",
        "book": "_build/pdf/book.pdf"
    },
    "environment_settings": {
        "big_envs": [
            {
                "prefix": "thm",
                "name": "Theorem",
                "numbered": true,
                "counter_group": "main",
                "color": "#2f62b5"
            },
            {
                "prefix": "lem",
                "name": "Lemma",
                "numbered": true,
                "counter_group": "main",
                "color": "#2f62b5"
            },
            {
                "prefix": "cor",
                "name": "Corollary",
                "numbered": true,
                "counter_group": "main",
                "color": "#2f62b5"
            },
            {
                "prefix": "prp",
                "name": "Proposition",
                "numbered": true,
                "counter_group": "main",
                "color": "#2f62b5"
            },
            {
                "prefix": "def",
                "name": "Definition",
                "numbered": true,
                "counter_group": "definition",
                "color": "#b0414f"
            },
            {
                "prefix": "exm",
                "name": "Example",
                "numbered": false,
                "color": "#3b7a4c"
            },
            {
                "prefix": "exr",
                "name": "Exercise",
                "numbered": false,
                "color": "#a8670c"
            }
        ],
        "small_envs": [
            "remark",
            "proof",
            "solution",
            "claim",
            "proofofclaim",
            "algorithm",
            "idea",
            "warning",
            "check"
        ]
    },
    "chapters": [
        {
            "dir": "src/ch01-matrix-algebra",
            "part": "Part I · Apparatus"
        },
        "src/ch02-random-vectors",
        "src/ch03-multivariate-normal",
        "src/ch04-quadratic-forms",
        {
            "dir": "src/ch05-model-and-least-squares",
            "part": "Part II · The Linear Model as a Projection"
        },
        "src/ch06-projections",
        "src/ch07-optimality",
        "src/ch08-estimability",
        "src/ch09-sums-of-squares",
        "src/ch10-computation",
        {
            "dir": "src/ch11-general-linear-hypothesis",
            "part": "Part III · Exact Inference under Normality"
        },
        "src/ch12-intervals-and-bands",
        "src/ch13-multiplicity",
        "src/ch14-correlation-lack-of-fit-prediction",
        {
            "dir": "src/ch15-anova-subspaces",
            "part": "Part IV · Rank Deficiency and Designed Structure"
        },
        "src/ch16-multiway-layouts",
        "src/ch17-unbalanced-data",
        "src/ch18-covariance-and-design",
        {
            "dir": "src/ch19-theory-of-departures",
            "part": "Part V · When the Assumptions Fail"
        },
        "src/ch20-residuals-leverage-influence",
        "src/ch21-nonnormality-heteroscedasticity-serial",
        "src/ch22-transformations",
        "src/ch23-resampling-inference",
        "src/ch24-errors-in-variables",
        "src/ch25-causal-interpretation",
        {
            "dir": "src/ch26-collinearity",
            "part": "Part VI · Trading Bias for Variance"
        },
        "src/ch27-shrinkage",
        "src/ch28-high-dimensional",
        "src/ch29-model-selection",
        "src/ch30-regularization-boosting",
        {
            "dir": "src/ch31-general-gauss-markov",
            "part": "Part VII · When the Errors Are Correlated"
        },
        "src/ch32-linear-mixed-models",
        "src/ch33-clustered-longitudinal-splitplot",
        {
            "dir": "src/ch34-exponential-families-glm",
            "part": "Part VIII · Beyond the Normal Response"
        },
        "src/ch35-binary-responses",
        "src/ch36-multinomial-ordinal",
        "src/ch37-counts",
        "src/ch38-quasi-likelihood",
        "src/ch39-glms-in-practice-bayes",
        "src/ch40-glmm-gee",
        "src/ch41-missing-data"
    ],
    "macros": "latex/macros.tex",
    "templates": {
        "html": "templates/html/template.html",
        "latex": "templates/latex/template.tex"
    },
    "styles": {
        "html": "templates/html/styles.css",
        "latex": "latex/latex-template.sty"
    },
    "deploy-dir": "site",
    "deploy-repo": "https://github.com/AkizumiFox/regression.git",
    "deploy-domain": "regression.akizumifox.com",
    "deploy-push-url": "git@github.com:AkizumiFox/regression.git",
    "issues-url": "https://github.com/AkizumiFox/regression/issues/new"
}
