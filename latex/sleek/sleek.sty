% =============================================================================
% Vendored from the "sleek" LaTeX style -- see latex/sleek/README.md for where
% it came from and for every change made to this copy. Upstream lines that were
% removed or changed are left behind as a comment saying so; the one line that
% was added is marked ADDED.
% =============================================================================
\ProvidesPackage{latex/sleek/sleek}[2020/10/29 v1.01 Sleek Package]

%%%%%%%%%%%%%%%%
% Requirements %
%%%%%%%%%%%%%%%%

% Encoding

\RequirePackage[utf8]{inputenc}
\RequirePackage[T1]{fontenc}
\RequirePackage{lmodern} % ADDED: T1 without cm-super would give bitmap fonts
% REMOVED: \RequirePackage{eurosym} -- no currency in this book

% Style

\RequirePackage{geometry}
\RequirePackage{fancyhdr}
\RequirePackage[bottom]{footmisc}

\edef\restoreparindent{\parindent=\the\parindent\relax}
% CHANGED: upstream is \RequirePackage[parfill]{parskip}. See the README: the
% parfill option costs 30pt of unshrinkable \parfillskip on every paragraph.
\RequirePackage{parskip}

\RequirePackage{enumitem}
% REMOVED: \RequirePackage{csquotes} -- the book does not use \enquote
\RequirePackage{xcolor}

% Links
% REMOVED: hyperref is loaded exactly once, by templates/latex/template.tex.
% Sleek's options (pdfusetitle, colorlinks, linktoc=page, allcolors=blue) reach
% it from latex/preamble.tex with \PassOptionsToPackage.

% Mathematics

\RequirePackage{amsmath}
\RequirePackage{amssymb}
\RequirePackage{bm}
% REMOVED: \RequirePackage{esint} -- no surface/volume integral signs

% Units
% REMOVED: \RequirePackage{siunitx} -- no physical units

% Figures
% REMOVED: \RequirePackage{float} -- no [H] placements

\RequirePackage[skip=1em]{caption}
\RequirePackage{subcaption}

% Arrays

\RequirePackage{array}
\RequirePackage{booktabs}
\RequirePackage{multirow}
% REMOVED: \RequirePackage{multicol} -- no multi-column pages

% Bibliography
% REMOVED: the whole biblatex block (backend=biber, style=numeric-comp, ...)
% and the \DefineBibliographyStrings that follow it. Neither edition of this
% book has a bibliography, so it only added a dependency and warnings.

%%%%%%%%%%%%
% Settings %
%%%%%%%%%%%%

% Parindent

\DeclareOption{parindent}{
    \restoreparindent
}

% Style
%
% CHANGED: upstream is top=3.5cm,bottom=2.5cm,right=2.5cm,left=2.5cm. The book
% has always used a uniform 2.5cm margin and this is the one place that decides
% it: latex/preamble.tex loads geometry with no options and lets this line set
% the page. Left and right are sleek's own values, so the measure -- and with it
% every line break in the book -- is unchanged.
\geometry{top=2.5cm,bottom=2.5cm,right=2.5cm,left=2.5cm}

\pagestyle{fancy}
\fancyhead[L]{}
\fancyhead[R]{\leftmark}
\fancyfoot[C]{\thepage}
% REMOVED: \renewcommand{\headrulewidth}{0pt} -- latex/chapter-style keeps the
% 0.4pt head rule this book has always had, and it is the only \headrulewidth
% left in the preamble.

% REMOVED: \DeclareOption{noheader} -- latex/chapter-style owns the running
% heads (it needs \part banners and \markboth, which sleek has no notion of).

% Arrays

\renewcommand{\arraystretch}{1.1}

% Languages
% REMOVED: \DeclareOption{french} -- it needs babel-french, siunitx and the
% bibliography strings above, none of which this book loads.

%%%%%%%%%%%%
% Commands %
%%%%%%%%%%%%

% Table of contents

\newcommand{\romantableofcontents}{ % creates a table of contents with roman (i, ii, iii, ...) numbering of the pages
    \newpage
    \pagenumbering{roman}
    \tableofcontents
    \newpage
    \pagenumbering{arabic}
}

% Mathematics

\newcommand{\rbk}[1]{\left(#1\right)} % round brackets (parentheses)
\newcommand{\cbk}[1]{\left\{#1\right\}} % curly brackets {braces}
\newcommand{\sbk}[1]{\left[#1\right]} % square brackets [brackets]
% REMOVED: \abs, \norm, \diff and \tr. latex/macros.tex and
% latex/latex-template.sty define all four; the book's \diff has better spacing
% than \mathrm{d}, and redefining any of them here would silently reflow the
% mathematics of all 24 chapters.

\newcommand{\fact}[1]{#1!} % factorial x!

% Figures

\newcommand{\noskipcaption}[1]{\caption{#1}\vspace{-1em}} % caption without additional vertical space

% Footnotes

\makeatletter
\def\blindfootnote{\gdef\@thefnmark{}\@footnotetext} % footnote without number
\makeatother

\ProcessOptions\relax

\endinput
