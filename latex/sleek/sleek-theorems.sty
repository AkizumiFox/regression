\ProvidesPackage{latex/sleek/sleek-theorems}[2020/10/28 v1.0 Sleek Theorems]

%%%%%%%%%%%%%%%%
% Requirements %
%%%%%%%%%%%%%%%%

\RequirePackage{amsthm}
\RequirePackage{thmtools}
\RequirePackage[framemethod=TikZ]{mdframed}

%%%%%%%%%%%%
% Settings %
%%%%%%%%%%%%

% Setup

\define@key{thmdef}{mdthm}[{}]{
    \thmt@trytwice{\def\thmt@theoremdefiner{\mdtheorem[#1]}}{}
}

\begingroup
\@for\theoremstyle:=plain,definition,remark\do{
    \expandafter\g@addto@macro\csname th@\theoremstyle\endcsname{
        \addtolength\thm@preskip\parskip
    }
}
\endgroup

% QED symbol
% REMOVED: \renewcommand{\qedsymbol}{$\blacksquare$} -- latex/latex-template.sty
% already sets exactly this, and it stays the one place that does.

\newcommand\qedadd{\pushQED{\qed}\popQED}

% Languages
% REMOVED: the \lgthm ... \lgtip strings and \DeclareOption{french}. The names
% of this book's environments come from config/config.json, through the
% declarations latex/theorem-envs.sty generates.

%%%%%%%%%%%%%%%%
% Environments %
%%%%%%%%%%%%%%%%

% Environments
% REMOVED: sleek's own thm/lem/prop/defn/hyp/meth/quest/answ/expl/rmk/note/tip
% and the framedthm ... framedexpl declarations built on them. This book's
% environments are the ones filters/theorems.lua emits; latex/theorem-envs.sty
% declares them with the same \declaretheorem[mdthm=...] pattern, taking each
% colour from config/config.json instead of sleek's red/blue/green.

% Framed environments

\mdfdefinestyle{thicc}{
    nobreak=true,
    skipabove=\topskip,
    skipbelow=\topskip,
    innerleftmargin=0.5em,
    innerrightmargin=0.5em,
    innerbottommargin=0.5em,
    innertopmargin=0.5em,
    linewidth=0.25em,
    roundcorner=0.15em,
    linecolor=black!10,
    frametitlebackgroundcolor=black!10,
    theoremseparator={.}
}

\ProcessOptions\relax

